---
import '../styles/global.css';
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Vesta - Inicio</title>
    </head>
    <body class="bg-[#050505] text-stone-400 flex items-center justify-center min-h-screen relative overflow-hidden">
        <main class="text-center w-full px-4 md:px-0">
        
        <h1 class="text-[6rem] md:text-[12rem] lg:text-[20rem] font-serif font-black text-stone-100 tracking-tighter opacity-5 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 select-none pointer-events-none">
            VESTA
        </h1>
      
        <div class="relative z-10">
            <h2 class="text-5xl md:text-6xl lg:text-8xl font-serif text-red-900 mb-10 lg:mb-16 uppercase tracking-widest drop-shadow-lg">Vesta</h2>
            
            <a 
                :href="`${import.meta.env.BASE_URL}crear`"
                class="inline-block px-4 py-3 text-xs md:text-base md:px-8 md:py-4 border border-stone-800 text-stone-300 hover:border-red-900 hover:text-red-500 transition-all uppercase tracking-widest font-bold bg-stone-950/80 shadow-[0_0_15px_rgba(127,29,29,0.1)] hover:shadow-[0_0_25px_rgba(127,29,29,0.4)]"
            >
                Crear nuevo personaje
            </a>
        </div>
        </main>
    </body>
</html>